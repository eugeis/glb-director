{
  "title": "GLB Director - throughput & pipeline (burst analysis)",
  "uid": "glb-director-throughput",
  "tags": ["glb", "lab", "dpdk", "throughput"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-6h", "to": "now" },
  "editable": true,
  "description": "Burst-optimised: short rate[15s] windows (the 1m/5m windows on the other dashboard smear 5-25s bursts down to 5-25% of the true rate). Zoom the time range onto a single burst to read its peak/total in the stat row. The pipeline panel puts RX/matched/encap/TX/KNI on ONE axis so losslessness (overlap) and the bottleneck are visible at a glance.",
  "panels": [
    {
      "id": 100, "type": "row", "title": "Summary over the selected time range",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": []
    },
    {
      "id": 1, "type": "stat", "title": "Peak RX (pps)",
      "datasource": { "type": "prometheus", "uid": "glb-prom" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "pps", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "max_over_time(sum(rate(glb_director_port_packets_rx_total[15s]))[$__range:5s])" }]
    },
    {
      "id": 2, "type": "stat", "title": "Peak encap (pps)",
      "datasource": { "type": "prometheus", "uid": "glb-prom" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "pps", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "max_over_time(sum(rate(glb_director_core_packets_encap_success_total[15s]))[$__range:5s])" }]
    },
    {
      "id": 3, "type": "stat", "title": "Total RX (pkts)",
      "datasource": { "type": "prometheus", "uid": "glb-prom" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "sum(increase(glb_director_port_packets_rx_total[$__range]))" }]
    },
    {
      "id": 4, "type": "stat", "title": "Total encapped (pkts)",
      "datasource": { "type": "prometheus", "uid": "glb-prom" },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "sum(increase(glb_director_core_packets_encap_success_total[$__range]))" }]
    },
    {
      "id": 5, "type": "stat", "title": "Dropped -> KNI / unclassified (pkts)",
      "datasource": { "type": "prometheus", "uid": "glb-prom" },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "sum(increase(glb_director_core_packets_kni_total[$__range]))" }]
    },
    {
      "id": 6, "type": "stat", "title": "RX ring loss: missed+nombuf+errors (pkts)",
      "datasource": { "type": "prometheus", "uid": "glb-prom" },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "sum(increase(glb_director_port_packets_rx_missed_total[$__range]) + glb_director_port_packets_rx_nombuf_total[$__range] + glb_director_port_packets_rx_errors_total[$__range])" }]
    },
    {
      "id": 101, "type": "row", "title": "Pipeline integrity (one axis)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "collapsed": false, "panels": []
    },
    {
      "id": 10, "type": "timeseries", "title": "RX -> matched -> encap -> TX  (+ KNI drops)  [rate 15s]",
      "datasource": { "type": "prometheus", "uid": "glb-prom" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "pps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "mean", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(glb_director_port_packets_rx_total[15s]))", "legendFormat": "RX (core01)" },
        { "refId": "B", "expr": "sum(rate(glb_director_core_packets_matched_total[15s]))", "legendFormat": "matched (core02)" },
        { "refId": "C", "expr": "sum(rate(glb_director_core_packets_encap_success_total[15s]))", "legendFormat": "encap (core02)" },
        { "refId": "D", "expr": "sum(rate(glb_director_core_packets_eth_tx_sent_total[15s]))", "legendFormat": "TX eth (core01)" },
        { "refId": "E", "expr": "sum(rate(glb_director_core_packets_kni_total[15s]))", "legendFormat": "KNI drops (core02)" }
      ]
    },
    {
      "id": 102, "type": "row", "title": "Classification & encapsulation detail",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }, "collapsed": false, "panels": []
    },
    {
      "id": 20, "type": "timeseries", "title": "Classification: matched / unmatched / KNI [15s]",
      "datasource": { "type": "prometheus", "uid": "glb-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "pps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(glb_director_core_packets_matched_total[15s]))", "legendFormat": "matched" },
        { "refId": "B", "expr": "sum(rate(glb_director_core_packets_unmatched_total[15s]))", "legendFormat": "unmatched" },
        { "refId": "C", "expr": "sum(rate(glb_director_core_packets_kni_total[15s]))", "legendFormat": "KNI (dropped)" }
      ]
    },
    {
      "id": 21, "type": "timeseries", "title": "Encapsulation: success / failure [15s]",
      "datasource": { "type": "prometheus", "uid": "glb-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "pps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(glb_director_core_packets_encap_success_total[15s]))", "legendFormat": "success" },
        { "refId": "B", "expr": "sum(rate(glb_director_core_packets_encap_failure_total[15s]))", "legendFormat": "failure" }
      ]
    },
    {
      "id": 30, "type": "timeseries", "title": "RX/TX health: ring misses, no-mbuf, errors [15s]  (all flat=0 except at the RX ceiling)",
      "datasource": { "type": "prometheus", "uid": "glb-prom" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "pps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(glb_director_port_packets_rx_missed_total[15s]))", "legendFormat": "rx_missed" },
        { "refId": "B", "expr": "sum(rate(glb_director_port_packets_rx_nombuf_total[15s]))", "legendFormat": "rx_nombuf" },
        { "refId": "C", "expr": "sum(rate(glb_director_port_packets_rx_errors_total[15s]))", "legendFormat": "rx_errors" },
        { "refId": "D", "expr": "sum(rate(glb_director_port_packets_tx_errors_total[15s]))", "legendFormat": "tx_errors" }
      ]
    },
    {
      "id": 103, "type": "row", "title": "3-lcore pipeline (per-core) + throughput",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }, "collapsed": false, "panels": []
    },
    {
      "id": 40, "type": "timeseries", "title": "core01 = RX + distribute + TX [15s]",
      "datasource": { "type": "prometheus", "uid": "glb-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "pps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(glb_director_core_packets_total{core=\"01\"}[15s]))", "legendFormat": "core01 processed (RX)" },
        { "refId": "B", "expr": "sum(rate(glb_director_core_packets_eth_tx_sent_total{core=\"01\"}[15s]))", "legendFormat": "core01 TX (eth)" }
      ]
    },
    {
      "id": 41, "type": "timeseries", "title": "core02 = classify + encap [15s]",
      "datasource": { "type": "prometheus", "uid": "glb-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "pps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(glb_director_core_packets_matched_total{core=\"02\"}[15s]))", "legendFormat": "core02 matched" },
        { "refId": "B", "expr": "sum(rate(glb_director_core_packets_encap_success_total{core=\"02\"}[15s]))", "legendFormat": "core02 encap" },
        { "refId": "C", "expr": "sum(rate(glb_director_core_packets_kni_total{core=\"02\"}[15s]))", "legendFormat": "core02 KNI" }
      ]
    },
    {
      "id": 50, "type": "timeseries", "title": "Throughput: RX vs TX bytes/s  (TX > RX by the GLB-GUE header overhead)",
      "datasource": { "type": "prometheus", "uid": "glb-prom" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 43 },
      "fieldConfig": { "defaults": { "unit": "Mbytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(glb_director_port_bytes_rx_total[15s]))", "legendFormat": "RX bytes" },
        { "refId": "B", "expr": "sum(rate(glb_director_port_bytes_tx_total[15s]))", "legendFormat": "TX bytes (encap'd)" }
      ]
    }
  ]
}
